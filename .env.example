# Authentication and database
NEXT_PUBLIC_APP_URL=http://localhost:3001
PORT=3001
APP_HOST=0.0.0.0
# Keep enabled on exactly one long-lived app process. Disable on additional replicas.
RUN_BACKGROUND_WORKER=true
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=
MONGODB_URI=
# Enable this when a single remote MongoDB node advertises localhost as its
# replica-set address. Leave false for Atlas and normal multi-node deployments.
MONGODB_DIRECT_CONNECTION=false

# Twitch data
TWITCH_CLIENT_ID=
# Used to refresh app access tokens automatically. May be omitted when
# TWITCH_CLIENT_ID matches AUTH_TWITCH_ID, in which case AUTH_TWITCH_SECRET is used.
TWITCH_CLIENT_SECRET=
TWITCH_ACCESS_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_BROADCASTER_LOGIN=n4cht4r4
# User access token with the moderator:read:chatters scope. The matching user
# must be the broadcaster or a moderator in Nachtara's chat. These values seed
# a server-only MongoDB credential record; future rotations use the saved token.
TWITCH_CHATTERS_ACCESS_TOKEN=
TWITCH_CHATTERS_REFRESH_TOKEN=
TWITCH_CHATTERS_MODERATOR_ID=
# Defaults to AUTH_TWITCH_ID and AUTH_TWITCH_SECRET when omitted.
TWITCH_CHATTERS_CLIENT_ID=
TWITCH_CHATTERS_CLIENT_SECRET=

# StreamElements donor sync. This JWT must remain server-only.
STREAMELEMENTS_JWT=
# Optional: obtained automatically through /channels/me when omitted.
STREAMELEMENTS_CHANNEL_ID=

# Riot verification and challenge updates
RIOT_API_KEY=
RIOT_DDRAGON_VERSION=14.10.1
# Protects the optional manual cron API endpoints. The persistent Node process
# already runs watchtime, Riot challenge, Discord queue, and donation jobs.
CRON_SECRET=

# Tournament staff authorization. Discord bot credentials are server-only.
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
TOURNAMENT_OWNER_DISCORD_IDS=
TOURNAMENT_ADMIN_ROLE_IDS=
DISCORD_TOURNAMENT_CATEGORY_ID=
DISCORD_TOURNAMENT_MEMBER_ROLE_ID=
# Optional existing role ID. When empty, the queued worker creates/reuses "Turnierkrone" automatically.
DISCORD_TOURNAMENT_WINNER_ROLE_ID=
# Optional cosmetic role users can claim after the seasonal meta challenge.
DISCORD_CHALLENGE_ROLE_ID=

# Creator credit shown in the footer
NEXT_PUBLIC_CREATOR_NAME=vexi
NEXT_PUBLIC_CREATOR_DISCORD_URL=https://discord.gg/g69uYP97Qh
NEXT_PUBLIC_CREATOR_TWITCH_URL=
NEXT_PUBLIC_AMAZON_WISHLIST_URL=
