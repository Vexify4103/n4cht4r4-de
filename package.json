{
	"name": "n4cht4r4-web",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"dev": "cross-env NODE_ENV=development tsx watch server/bootstrap.ts",
		"build": "next build && tsup server/bootstrap.ts --format esm --target node22 --out-dir dist --external next --sourcemap",
		"start": "cross-env NODE_ENV=production node dist/bootstrap.mjs",
		"lint": "eslint .",
		"seed:tournaments": "node scripts/seed-tournaments.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@next/env": "^15.5.19",
		"@auth/mongodb-adapter": "^3.11.2",
		"cron": "^4.4.0",
		"lucide-react": "^0.468.0",
		"mongodb": "^7.3.0",
		"next": "^15.1.3",
		"next-auth": "5.0.0-beta.31",
		"prettier": "^3.8.4",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"swr": "^2.4.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.0.2",
		"@types/react-dom": "^19.0.2",
		"cross-env": "^10.0.0",
		"eslint": "^9.17.0",
		"eslint-config-next": "^15.1.3",
		"tsx": "^4.20.5",
		"tsup": "^8.5.0",
		"typescript": "^5.7.2"
	}
}
